[Unit]
Description=Backend V1 FastAPI service
After=network.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -lc 'exec "__VENV_DIR__/bin/uvicorn" app:app --host "${UVICORN_HOST:-0.0.0.0}" --port "${UVICORN_PORT:-28010}" --proxy-headers --forwarded-allow-ips "${FORWARDED_ALLOW_IPS:-*}" --ws-ping-interval 30 --ws-ping-timeout 60'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
