# Backend V1 - Deployment Configuration
# Copy to .env and adjust before running.
#
# UVICORN_HOST / UVICORN_PORT are read by uvicorn natively.
# FORWARDED_ALLOW_IPS is read by uvicorn from the environment.
# BACKEND_* variables are read by config.py.

# Network
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8011
FORWARDED_ALLOW_IPS=192.168.200.100,10.200.0.14,10.200.0.15

# Data paths
BACKEND_DATA_BASE_DIR=/mnt/plane/B11
BACKEND_LOCAL_RADAR_BASE_DIR=/data/yujie/backend_v1.1/radar
BACKEND_DATE1=2026-05-30
BACKEND_NUM=1
BACKEND_AIRCRAFT_MODEL=B11

# Behavior
BACKEND_ALLOW_SIMULATED_FALLBACK=false

# Security
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_AUTH_SECRET_KEY=
